app = "strata-email-mcp"
primary_region = "iad"

[build]
  dockerfile = "Dockerfile"

[env]
  HOST = "0.0.0.0"
  PORT = "8080"
  EMAIL_PROVIDER = "resend"
  EMAIL_FROM = "strata-mcp@theforkproject.com"
  DATA_DIR = "/data/email-mcp"
  PUBLIC_BASE_URL = "https://strata-email-mcp.fly.dev"
  CERTIFICATE_BASE_URL = "https://strata-email-mcp.fly.dev/certificates"
  OAUTH_ISSUER = "https://strata-email-mcp.fly.dev"
  OAUTH_STORE_PATH = "/data/email-mcp/oauth-store.json"
  WITNESS_URLS = "w1=https://strata-email-witness-1.fly.dev,w2=https://strata-email-witness-2.fly.dev,w3=https://strata-email-witness-3.fly.dev"

[[mounts]]
  source = "strata_email_mcp_data"
  destination = "/data"

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = false
  auto_start_machines = true
  min_machines_running = 1

  [[http_service.checks]]
    interval = "15s"
    timeout = "2s"
    grace_period = "10s"
    method = "GET"
    path = "/health"
