# Server
PORT=8899
HOST=127.0.0.1
MCP_SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional simple bearer auth for non-OAuth demo deployments.
# MCP_BEARER_TOKEN=replace-with-demo-token

# Email provider
# Use EMAIL_PROVIDER=dry-run for local demos without sending.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="strata-mcp@theforkproject.com"
# Optional provider base URL override.
# RESEND_BASE_URL=https://api.resend.com

# Public/demo URLs used in email headers and MCP results.
PUBLIC_BASE_URL=http://127.0.0.1:8899
CERTIFICATE_BASE_URL=http://127.0.0.1:8899/certificates

# Level 1 witness servers. The local demo script starts three witnesses automatically.
# Format: w1=http://127.0.0.1:9101,w2=http://127.0.0.1:9102,w3=http://127.0.0.1:9103
WITNESS_URLS=
WITNESS_THRESHOLD=2
# Official Tinfoil witness mode uses gateway-signed WitnessSignRequest v1.
GATEWAY_SIGNED_WITNESS_REQUESTS_ENABLED=false
# Gateway key id must be authorized in the witness registry epoch when signed requests are enabled.
GATEWAY_ID=gateway:email-mcp
GATEWAY_KEY_ID=gateway:email-mcp
# Optional: load an authorized gateway key from a bootstrap bundle, e.g. ../strata-ebo-turnstile/artifacts/tinfoil-witness-poc/gateway-registry-keys.json
GATEWAY_KEY_BUNDLE_FILE=
WITNESS_EPOCH_ID=
REGISTRY_EPOCH_ID=
WITNESS_WORKFLOW_ID=email.send
POLICY_WITNESS_URLS=
POLICY_WITNESS_THRESHOLD=2
REGISTRY_URL=

# Governance-hosted active policy bundle. Defaults to REGISTRY_URL/policies/epochs/email-policy-epoch-001 when REGISTRY_URL is set.
POLICY_BUNDLE_URL=
# Local fallback/source file used by dev, policy witnesses, and registry publication.
POLICY_BUNDLE_FILE=policies/email-policy-epoch-001.json

# Operator admission manifest signing. The MCP gateway signs the active tenant manifest into every session.start.
TENANT_ID=default
OPERATOR_ID=operator:amotivv-demo
OPERATOR_ADMISSION_KEY_ID=operator-admission:amotivv-demo
# Defaults to DATA_DIR/keys/operator-admission.key.json.
# OPERATOR_ADMISSION_KEY_FILE=artifacts/email-mcp/keys/operator-admission.key.json
# Tinfoil deployments should inject the operator admission key as a secret instead of relying on generated ephemeral files.
# OPERATOR_ADMISSION_KEY_JSON='{"key_id":"operator-admission:amotivv-demo","private_key_pem":"...","public_key_pem":"..."}'
# Registry-only: public operator admission key published by /operators/*.
# OPERATOR_ADMISSION_PUBLIC_KEY_PEM_BASE64=base64-of-public-key-pem

# Artifact storage
DATA_DIR=artifacts/email-mcp

# OAuth 2.1 / Claude Desktop remote connector support
# Set this to the public HTTPS origin when hosted, e.g. https://strata-email-mcp.fly.dev
OAUTH_ISSUER=
OAUTH_STORE_PATH=artifacts/email-mcp/oauth-store.json
# Use one of these. SHA-256 avoids storing the plaintext passphrase.
OAUTH_CONSENT_PASSWORD=
OAUTH_CONSENT_PASSWORD_SHA256=
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
OAUTH_CODE_TTL_SECONDS=600
